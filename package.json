{
  "name": "peptide-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --workspace=server run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
