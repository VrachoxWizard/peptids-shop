# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (PostgreSQL 16+)
# Primjeri:
# - Lokalni Postgres: postgres://postgres:postgres@localhost:5432/peptidelab
# - Neon / Supabase cloud: postgres://user:password@ep-xyz.eu-central-1.aws.neon.tech/peptidelab?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/peptidelab

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# E-Commerce & Shipping Rules (Sync s frontendskim shop.ts)
SHOP_CURRENCY=EUR
FREE_SHIPPING_THRESHOLD=70
SHIPPING_FEE=4.90

# Podaci za Plaćanje Virmanom / HUB3 2D barkod
COMPANY_NAME=PeptideLab d.o.o.
COMPANY_IBAN=HR1234567890123456789
COMPANY_MODEL=HR00
COMPANY_STREET=Istraživačka 10
COMPANY_CITY=Zagreb

# Admin API zaštita (za upravljačku ploču /admin i ažuriranje narudžbi)
ADMIN_API_KEY=dev_admin_secret_key_replace_in_prod

# Transakcijski emailovi (Resend.com)
RESEND_API_KEY=re_123456789
STORE_OWNER_EMAIL=admin@peptidelab.hr
EMAIL_FROM=PeptideLab <narudzbe@peptidelab.hr>
