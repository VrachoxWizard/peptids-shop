# ==============================================================================
# Vercel Deployment & Local Development Environment Variables
# ==============================================================================

# 1. Baza Podataka (PostgreSQL - npr. Neon.tech Serverless Postgres ili Supabase)
# Koristite pooled connection string sa sslmode=require
DATABASE_URL=postgres://user:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/peptidelab?sslmode=require

# 2. Okruženje i CORS
NODE_ENV=production
CORS_ORIGIN=*

# 3. Postavke Trgovine i HUB3 Virmana (SEPA uplatnica)
SHOP_CURRENCY=EUR
FREE_SHIPPING_THRESHOLD=70
SHIPPING_FEE=4.90
COMPANY_NAME=PeptideLab d.o.o.
COMPANY_IBAN=HR1234567890123456789
COMPANY_MODEL=HR00
COMPANY_STREET=Istraživačka 10
COMPANY_CITY=Zagreb

# 4. Administratorska Zaštita (/admin ploča i API rute)
# Zamijenite s vlastitim sigurnim tajnim ključem:
ADMIN_API_KEY=moj_sigurni_tajni_kljuc_za_admina_2026

# 5. Transakcijski Email Servis (Resend.com) - Opcionalno
RESEND_API_KEY=re_123456789
STORE_OWNER_EMAIL=admin@peptidelab.hr
EMAIL_FROM=PeptideLab <narudzbe@peptidelab.hr>
